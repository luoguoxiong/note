    "@langchain/deepseek": "^1.1.21",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/mcp-adapters": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.8",
    "express": "^4.21.2",
    "ioredis": "^5.11.1",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.23.15",

{
  "name": "netc-pc-web-admin",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare": "husky install",
    "preinstall": "node -e \"if(process.env.npm_execpath.indexOf('yarn') === -1) throw new Error('You must use Yarn, not NPM')\"",
    "preserve:uat": "node -e \"if(process.env.npm_execpath.indexOf('yarn') === -1) throw new Error('You must use Yarn, not NPM')\"",
    "serve:dev": "vue-cli-service serve --mode dev",
    "serve:prod": "vue-cli-service serve --mode prod",
    "serve:stg": "vue-cli-service serve --mode stg",
    "serve:uat": "vue-cli-service serve --mode uat",
    "serve:preview": "cross-env ENV_ISPREVIEW=true vue-cli-service serve --mode uat",
    "build": "vue-cli-service build",
    "analyse": "cross-env ANAYLYSE=true vue-cli-service build",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "vue-cli-service test:e2e",
    "lint": "vue-cli-service lint & npm run stylelint --fix",
    "stylelint": "stylelint \"**/*.scss\"",
    "stylelint:fix": "stylelint \"**/*.scss\" --ignore-pattern 'src/styles/tools/mixins.scss' --fix",
    "styleguide": "vue-cli-service styleguidist",
    "styleguide:build": "vue-cli-service styleguidist:build",
    "tsc": "vue-tsc --noEmit --skipLibCheck --allowJs"
  },

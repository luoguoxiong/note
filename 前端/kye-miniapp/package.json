{
  "name": "kye-minapp",
  "version": "8.2.51",
  "private": true,
  "description": "跨越速运小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "Vue3"
  },
  "scripts": {
    "log": "kycli log",
    "start": "kycli start",
    "build": "kycli build",
    "upload": "kycli upload",
    "build:uat": "kycli build --env uat",
    "analyze": "taro build --type weapp --mode uat --analyze",
    "dev:wx:preview": "taro build --type weapp --watch --mode uat --preview",
    "dev:wx": "taro build --type weapp --watch --mode uat",
    "dev:wx:apush": "node dev-wx-apush.js",
    "build:wx:uat": "taro build --type weapp --mode uat",
    "build:wx:prod": "taro build --type weapp",
    "build:h5:uat": "npm run build:h5 --mode uat",
    "build:h5": "taro build --type h5",
    "dev:wx:temp": "taro build --type weapp --watch --mode uat --temporary",
    "build:wx:uat:temp": "taro build --type weapp --mode uat --temporary",
    "dev:alipay": "taro build --type alipay --watch --mode uat",
    "dev:h5": "taro build --type h5 --mode uat --watch --env development",
    "build:alipay:uat": "taro build --type alipay --mode uat",
    "build:alipay:prod": "taro build --type alipay",
    "eslint": "eslint ./**/*.{vue,js,ts,tsx} --fix",
    "stylelint": "stylelint ./**/*.{css,scss}' --fix",
    "init:trae": "node .agent/init-ide.js trae",
    "init:claude": "node .agent/init-ide.js cc",
    "init:cursor": "node .agent/init-ide.js cursor",
    "init:windsurf": "node .agent/init-ide.js windsurf",
    "init:codebuddy": "node .agent/init-ide.js codebuddy",
    "init:all": "node .agent/init-ide.js all",
    "init:ide": "node .agent/init-ide.js"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"

.native-login {
  height: 100%;
  min-height: 100%;
}

.native-login .icon-loading {
  width: 32rpx;
  height: 32rpx;
  margin-right: 4rpx;
  animation-duration: 2s;
  animation: icon-rotate 0.8s linear infinite;
}

.native-login .btn {
  height: 88rpx;
  width: 560rpx;
  margin: 0 auto;
  background-color: #8365f6;
  font-size: 32rpx;
  border-radius: 16rpx;
  border-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #fff;
}

.native-login .btn:active {
  background-color: #8356f6;
}

@keyframes icon-rotate {
  0% {
    transform: rotate(0)
  }

  to {
    transform: rotate(360deg)
  }
}

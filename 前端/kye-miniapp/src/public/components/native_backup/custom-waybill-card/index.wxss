.waybill-card {
  background-color: #ffffff;
  border-radius: 16px;
  overflow: hidden;
}

/* 头部 */
.waybill-card-head {
  padding: 12px 24px;
  background: linear-gradient(
      180deg,
      rgba(183, 177, 208, 0) 50%,
      rgba(183, 177, 208, 0.09) 89%,
      rgba(183, 177, 208, 0.1) 100%
    ),
    #ffffff;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.waybill-card-head-left {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.waybill-card-number {
  font-size: 28px;
  line-height: 40px;
  font-weight: 600;
  color: #24262b;
  display: flex;
  align-items: center;
}

.waybill-card-number image {
  width: 28px;
  height: 28px;
  margin-right: 8px;
  flex-shrink: 0;
}

.waybill-card-copy {
  margin-left: 4px;
}

.waybill-card-copy image {
  width: 28px;
  height: 28px;
  display: block;
}

/* 内容区 */
.waybill-card-content {
  padding: 24px;
  position: relative;
}

.waybill-card-absolute {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 32px;
  width: 306px;
  text-align: center;
  margin: 0 auto;
  font-size: 20px;
  line-height: 32px;
  color: #fa7d00;
  background-size: contain;
  background-repeat: no-repeat;
  background-image: url("https://ic-img.ky-express.com/netc/20250619_48242_!!1750321540939_612_64.png");
}

.waybill-card-info {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.waybill-card-info-right {
  flex: 1;
  min-width: 0;
  max-width: 100%;
}

.waybill-card-info-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  position: relative;
}

.send-receive-info {
  flex: 1;
  max-width: 100%;
  min-width: 0;
}

.send-receive-info__city {
  font-size: 34px;
  font-weight: 600;
  line-height: 48px;
  color: #24262b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
}

.send-receive-info__name,
.send-receive-info__company {
  font-size: 24px;
  line-height: 34px;
  color: #8c8f99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: 8px;
}

.send-receive-info__company2 {
  font-size: 24px;
  line-height: 34px;
  color: #8c8f99;
  margin-top: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.send-receive-info-right {
  text-align: right;
}

.send-receive-logistics {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.waybill-status {
  font-size: 24px;
  line-height: 34px;
  color: #24262b;
}

.status-error {
  color: #ff706d;
}

.send-receive-logistics image {
  pointer-events: none;
  width: 138px;
  height: 14px;
  display: block;
  margin: 8px 0;
}

.waybill-service {
  font-size: 24px;
  line-height: 34px;
  color: #24262b;
}

.stamp-box {
  position: absolute;
  left: 56%;
  top: 12px;
}

.stamp-box image {
  height: 120px;
  width: 120px;
}

/* 额外信息 */
.waybill-card-extra {
  margin-top: 24px;
}

.waybill-card-extra .black-color {
  color: #24262b;
}

.waybill-card-extra .mr4 {
  margin-right: 4px;
}

.waybill-card-extra .mr8 {
  margin-right: 8px;
}

.waybill-card-extra-status {
  font-size: 24px;
  line-height: 34px;
  color: #8c8f99;
  display: flex;
}

.waybill-card-extra-status > view {
  flex-shrink: 0;
}

.waybill-card-extra-info {
  margin-top: 8px;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.waybill-card-extra-info-label {
  font-size: 24px;
  line-height: 34px;
  color: #8c8f99;
  flex-shrink: 0;
}

.waybill-card-extra-info-content {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 24px;
  line-height: 34px;
}

.waybill-card-extra-info-content .ky-tab {
  margin-left: 4px;
}

.waybill-card-extra-label {
  padding: 11px 16px;
  background: #f7f8fa;
  display: flex;
  align-items: center;
  border-radius: 8px;
}

.waybill-card-extra-label-icon {
  margin-right: 8px;
  width: 38px;
  height: 38px;
  flex-shrink: 0;
}

.waybill-card-extra-label-text {
  font-size: 24px;
  line-height: 34px;
  color: #686b75;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

/* 其他通用类 */
.mb-16 {
  margin-bottom: 16px;
}

.waybill-card-extra-applyStatus {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24px;
  background-color: #fff3e5;
  color: #ff9300;
  font-size: 24px;
  margin: 16px 0;
  border-radius: 8px;
}

.waybill-card-extra-applyStatus-icon {
  width: 32px;
  height: 32px;
}

.ky-tag + .ky-tag {
  margin-bottom: 0;
}

.mb24 {
  margin-bottom: 24px;
}

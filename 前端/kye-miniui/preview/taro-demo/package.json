{
  "name": "taro-ui-demo",
  "version": "1.0.0",
  "private": true,
  "description": "跨越速运小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "Vue3"
  },
  "scripts": {
    "build:wx": "taro build --type weapp",
    "build:weapp:uat": "npm run type-check && taro build --type weapp --mode uat",
    "build:swan": "npm run type-check && taro build --type swan",
    "build:alipay": "npm run type-check && taro build --type alipay",
    "build:alipay:uat": "npm run type-check && taro build --type alipay --mode uat",
    "build:tt": "npm run type-check && taro build --type tt",
    "build:h5": "npm run type-check && taro build --type h5",
    "build:rn": "npm run type-check && taro build --type rn",
    "build:qq": "npm run type-check && taro build --type qq",
    "build:jd": "npm run type-check && taro build --type jd",
    "build:harmony-hybrid": "taro build --type harmony-hybrid",
    "dev:wx": "npm run build:wx -- --watch",
    "dev:swan": "npm run build:swan -- --watch",
    "dev:alipay": "npm run build:alipay -- --watch --mode uat",
    "dev:tt": "npm run build:tt -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "dev:rn": "npm run build:rn -- --watch",
    "dev:qq": "npm run build:qq -- --watch",
    "dev:jd": "npm run build:jd -- --watch",
    "dev:harmony-hybrid": "npm run build:harmony-hybrid -- --watch",
    "type-check": "vue-tsc --noEmit --skipLibCheck || echo 'Type check failed. Proceeding with build...'"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "author": "",
  "dependencies": {
    "@kye-netc/plateform": "0.2.18",
    "@babel/runtime": "^7.24.4",
    "@ky-miniui-lib/ky-miniui-lib": "workspace:^",
    "@tarojs/components": "4.1.2",
    "@tarojs/helper": "4.1.2",
    "@tarojs/plugin-framework-vue3": "4.1.2",
    "@tarojs/plugin-html": "4.1.2",
    "@tarojs/plugin-http": "4.1.2",
    "@tarojs/plugin-platform-alipay": "4.1.2",
    "@tarojs/plugin-platform-h5": "4.1.2",
    "@tarojs/plugin-platform-harmony-hybrid": "4.1.2",
    "@tarojs/plugin-platform-jd": "4.1.2",
    "@tarojs/plugin-platform-qq": "4.1.2",
    "@tarojs/plugin-platform-swan": "4.1.2",
    "@tarojs/plugin-platform-tt": "4.1.2",
    "@tarojs/plugin-platform-weapp": "4.1.2",
    "@tarojs/runtime": "4.1.2",
    "@tarojs/shared": "4.1.2",
    "@tarojs/taro": "4.1.2",
    "add": "^2.0.6",
    "axios": "^1.7.8",
    "dayjs": "^1.11.13",
    "js-md5": "^0.8.3",
    "taro-axios": "^1.1.1",
    "vue": "^3.0.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-proposal-class-properties": "7.14.5",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@tarojs/cli": "4.1.2",
    "@tarojs/taro-loader": "4.1.2",
    "@tarojs/test-utils-vue3": "^0.1.1",
    "@tarojs/webpack5-runner": "4.1.2",
    "@types/js-md5": "^0.7.2",
    "@types/node": "^18",
    "@types/webpack-env": "^1.13.6",
    "@umengfe/mini-apm": "1.0.6",
    "@vue/babel-plugin-jsx": "^1.2.2",
    "@vue/compiler-sfc": "^3.0.0",
    "babel-preset-taro": "4.1.2",
    "css-loader": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.1.2",
    "eslint-plugin-vue": "^9.17.0",
    "postcss": "^8.4.38",
    "prettier": "^3.3.3",
    "sass": "^1.75.0",
    "style-loader": "^3.3.4",
    "stylelint": "^16.4.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "^5.4.5",
    "vue-loader": "^17.4.2",
    "webpack": "5.91.0"
  }
}

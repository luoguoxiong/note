{
  "compilerOptions": {
    "target": "es2015",
    "lib": [
      "es2015",
      "DOM",
    ],
    "module": "commonjs",
    "rootDir": "./",
    "allowJs": true,
    "isolatedModules": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@packages/*": ["../../packages/*"]
    }
  }
}

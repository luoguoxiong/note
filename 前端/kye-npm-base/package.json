{
  "name": "@kye-netc/tools",
  "version": "0.0.26",
  "description": "跨越互联网-前端工具库",
  "scripts": {
    "dev": "pnpm --filter {packages/*} dev",
    "build": "pnpm --filter {packages/*} build",
    "run publish": "pnpm --filter {packages/*} publish",
    "publish": "pnpm --filter {packages/*} publish --no-git-checks",
    "demo": "pnpm --filter demo serve",
    "doc:dev": "dumi dev",
    "doc:build": "dumi build",
    "doc:preview": "dumi preview"
  },
  "authors": [],
  "license": "MIT",
  "devDependencies": {
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "dumi": "^2.4.13",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^17.0.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.1.1",
    "father": "^4.5.3",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "pnpm": "10.6.1",
    "prettier": "^3.3.3"
  }
}
